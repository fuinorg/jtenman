<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin</groupId>
        <artifactId>jtenman</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jtenman-starter</artifactId>

    <name>jtenman-starter</name>
    <description>Spring Boot starter an administered application adds to replicate its tenant list from
        jtenman</description>

    <!--
        The one module written for a consumer rather than for jtenman itself. Everything it pulls in
        lands on the class path of somebody else's application, so the dependency list is deliberately
        short: the read-model contract, the Keycloak tenant abstractions it implements, and Spring.

        It must NEVER depend on jtenman-internal. That module carries the event store, the JPA
        bookkeeping and the control plane's own filter chain, all as auto-configurations - a consumer
        inheriting it would open a KurrentDB connection it has no use for and pin its own security to
        the 'tenant-admin' role.
    -->

    <dependencies>

        <!-- compile -->

        <!-- The read-model contract: TenantService, TenantControllerApi and the generated REST client
             that satisfies the first through the second. -->
        <dependency>
            <groupId>org.fuin</groupId>
            <artifactId>jtenman-query-api</artifactId>
        </dependency>

        <!-- TenantDetails and the value objects it is made of. -->
        <dependency>
            <groupId>org.fuin</groupId>
            <artifactId>jtenman-shared</artifactId>
        </dependency>

        <!-- JwtTenantRepository and JwtTenant - what this module implements and hands out. -->
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-springboot-keycloak-core</artifactId>
        </dependency>

        <!-- TenantId plus the added/removed events the caches downstream listen to. -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-core</artifactId>
        </dependency>

        <!-- The Jackson modules the private mapper of this starter needs to read a TenantDetails. -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.objects4j</groupId>
            <artifactId>objects4j-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.objects4j</groupId>
            <artifactId>objects4j-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- RestClient and the @HttpExchange proxy factory the generated contract is used through. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- optional -->

        <!-- Spring Security's OAuth2 client, used to obtain and cache the service account token the
             tenant list is fetched with. Optional: an application that authenticates the pull some other
             way, or not at all, should not have to carry it. TenantListClientCredentialsAutoConfiguration
             is conditional on it being present. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- provided -->

        <!-- Referenced only by the 'before' attribute of TenantRegistryAutoConfiguration. The consuming
             application declares the keycloak starter itself - that is the whole reason this module
             exists - so it must not travel from here. -->
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-springboot-keycloak-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.fuin</groupId>
            <artifactId>jtenman-test-helper</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockRestServiceServer, so the pull is exercised against a real RestClient and real JSON
             rather than a stubbed TenantService. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A value object validates itself on construction, so building one in a test needs a Bean
             Validation provider. At runtime the application supplies it. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.fuin.jtenman.starter</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
