<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>org.fuin</groupId>
    <artifactId>jtenman</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jtenman</name>
    <description>Tenant control plane - registers tenants and the applications they use (CQRS)</description>
    <!-- Each published module repeats this url instead of inheriting it: Maven appends the module's own
         path to an inherited one, and the 'child.project.url.inherit.append.path' attribute that is meant
         to stop that has no effect on Maven 3.9.15. The scm url below does not need the same treatment -
         there the attribute is honoured. -->
    <url>https://github.com/fuinorg/jtenman/</url>

    <!--
        Declared here rather than inherited, and that is the point of having it at all. The parent is
        spring-boot-starter-parent, which declares its own url, licenses, developers and scm - so an
        artifact published without this block would go out under the Apache licence, with "Spring /
        VMware, Inc." as its developer and a spring-projects GitHub url. Same licence as every other
        fuinorg artifact, spelled the way org.fuin:pom spells it.
    -->
    <licenses>
        <license>
            <name>LGPL</name>
            <url>http://www.fsf.org/licensing/licenses/lgpl.html</url>
            <distribution>repo</distribution>
            <comments>GNU Lesser General Public License</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>michael-schnell</id>
            <name>Michael Schnell</name>
            <organization>fuin.org</organization>
            <organizationUrl>http://www.fuin.org/</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/fuinorg/jtenman/</url>
        <connection>scm:git:git://github.com/fuinorg/jtenman.git</connection>
        <developerConnection>scm:git:git@github.com:fuinorg/jtenman.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/fuinorg/jtenman/issues</url>
    </issueManagement>

    <properties>
        <java.version>25</java.version>
        <!--
            Whether a module is left out of the publish, and the default is to leave it out: a consumer
            wants the libraries that land on its own class path, not the control plane. The three that say
            'false' - shared, query/api and starter - are the whole of what jtenman offers anybody else.
            Anything new is excluded until somebody decides otherwise, which is the safe direction.
        -->
        <jtenman.publishing.skip>true</jtenman.publishing.skip>
        <utils4.version>0.16.1-SNAPSHOT</utils4.version>
        <objects4j.version>0.12.0-SNAPSHOT</objects4j.version>
        <ddd4j.version>0.8.0-SNAPSHOT</ddd4j.version>
        <cqrs4j.version>0.7.0-SNAPSHOT</cqrs4j.version>
        <cqrs4j-springboot.version>0.7.0-SNAPSHOT</cqrs4j-springboot.version>
        <esc.version>0.10.0-SNAPSHOT</esc.version>
        <jandex.version>3.2.7</jandex.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <org-fuin-bom.version>1.0.2-SNAPSHOT</org-fuin-bom.version>
        <junit-bom.version>5.14.4</junit-bom.version>
        <classgraph.version>4.8.184</classgraph.version>
        <jspecify.version>1.0.0</jspecify.version>
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.13.6</nullaway.version>
        <!-- Empty by default; a module overrides it to add NullAway options (see maven-compiler-plugin). -->
        <nullaway.extraOpts/>
        <cqrs-common-java.version>0.1.0-SNAPSHOT</cqrs-common-java.version>
        <rest-assured.version>5.5.0</rest-assured.version>
        <springdoc.version>2.8.6</springdoc.version>
        <!-- Must match the Keycloak version jtenman administers (steering/tech.md). -->
        <keycloak.version>26.0.7</keycloak.version>
        <!-- Annotations only: @RegisterRestClient on the generated «View»ResourceApi contracts in
             query/api. Not managed by spring-boot-dependencies, so pin it here. -->
        <microprofile-rest-client.version>4.0</microprofile-rest-client.version>
    </properties>

    <dependencyManagement>

        <dependencies>

            <!-- bom -->

            <!-- Align the entire JUnit stack (jupiter + platform) to a single version. The Spring Boot
                 parent manages jupiter/platform at one version, while org.fuin:bom pulls
                 junit-platform-suite at another, leaving the platform jars mismatched and breaking test
                 discovery. Importing junit-bom first wins and keeps them in sync. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Super BOM aligned with the Spring Boot 3.5 BOM. MUST stay ahead of any other imported
                 BOM: an imported BOM only wins against another imported BOM declared later. -->
            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>bom</artifactId>
                <version>${org-fuin-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.fuin.objects4j</groupId>
                <artifactId>objects4j-bom</artifactId>
                <version>${objects4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.fuin.esc</groupId>
                <artifactId>esc-bom</artifactId>
                <version>${esc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.fuin.ddd4j</groupId>
                <artifactId>ddd-4-java-bom</artifactId>
                <version>${ddd4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-bom</artifactId>
                <version>${cqrs4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                The Spring Boot flavour moved to its own repository (fuinorg/cqrs-4-springboot) and
                publishes its own BOM. No artifactId changed - only the version of the springboot
                artifacts now comes from here rather than from cqrs-4-java-bom, and the two can be
                released independently.
            -->
            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-bom</artifactId>
                <version>${cqrs4j-springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- project -->

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-internal</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-command-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-command-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-command-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-query-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-query-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-query-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>jtenman-test-helper</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- compile -->

            <dependency>
                <groupId>org.fuin.dsl.cqrs.contexts</groupId>
                <artifactId>cqrs-common-java</artifactId>
                <version>${cqrs-common-java.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>utils4j</artifactId>
                <version>${utils4.version}</version>
            </dependency>

            <!-- Admin API client used to provision realms and clients. Its version must match the
                 Keycloak version being administered - the admin API is not compatible across majors. -->
            <dependency>
                <groupId>org.keycloak</groupId>
                <artifactId>keycloak-admin-client</artifactId>
                <version>${keycloak.version}</version>
                <exclusions>
                    <!-- It drags in the legacy "org.jboss:jandex" 2.4.5, which carries the SAME
                         "org.jboss.jandex" package as the "io.smallrye:jandex" 3.x this project indexes
                         and reads with. Two jars, one package: whichever comes first on the class path
                         wins, and the old reader cannot read a version 12 index - it fails with
                         "Can't read index version 12" while building the object mapper, which reads as a
                         Jackson problem. Excluding it leaves exactly one jandex everywhere instead of
                         relying on the order Maven happens to produce. -->
                    <exclusion>
                        <groupId>org.jboss</groupId>
                        <artifactId>jandex</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Not part of the cqrs-4-java BOM, so pin it to the same version as the rest. -->
            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-test-helper</artifactId>
                <version>${cqrs4j.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>

            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.microprofile.rest.client</groupId>
                <artifactId>microprofile-rest-client-api</artifactId>
                <version>${microprofile-rest-client.version}</version>
            </dependency>

            <!-- Override the classgraph version dragged in transitively by webjars-locator-core; newer
                 releases avoid the deprecated sun.misc.Unsafe::invokeCleaner call that warns on JDK 25. -->
            <dependency>
                <groupId>io.github.classgraph</groupId>
                <artifactId>classgraph</artifactId>
                <version>${classgraph.version}</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <!-- JSpecify annotations (@NullMarked / @Nullable) are used across every module, so they are
         declared once here and inherited by all children. -->
    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <modules>
        <module>model</module>
        <module>shared</module>
        <module>internal</module>
        <module>query</module>
        <module>command</module>
        <module>starter</module>
        <module>test-helper</module>
        <module>combined</module>
        <module>e2e</module>
    </modules>

    <build>

        <plugins>

            <!--
                Publishes a pom with no <parent>.

                Every dependency version in this project comes from spring-boot-starter-parent or from the
                BOMs imported below, so an unflattened pom is unusable to a consumer without resolving the
                whole chain above it. Flattening writes the resolved versions inline, which means the
                parent and the aggregator poms do not have to be published at all - the three libraries
                stand on their own.

                'oss' mode keeps the name, description, url, licences, developers and scm that Central
                requires; the metadata block at the top of this file is what those are filled from, and
                without it they would be filled from spring-boot-starter-parent.

                In the main build rather than in the release profile on purpose: what is installed into
                ~/.m2 is then exactly what gets deployed, so a consumer resolving locally exercises what
                its CI will resolve from Central. Pom-packaged modules are skipped by default, so the
                aggregators keep their own poms.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Integration tests are named "*IT" and spin up containers, so they run in the "verify"
                 phase via failsafe - surefire's default includes ("*Test") deliberately do not match
                 them, keeping "mvn test" free of any container runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Error Prone hosts the NullAway null-safety check. NullAway only inspects @NullMarked
                 (JSpecify) packages (OnlyNullMarked=true), so modules/packages without a @NullMarked
                 package-info are left untouched. Test sources are excluded. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <!-- "nullaway.extraOpts" is the extension point for a module that needs one more
                             NullAway option: -XepOpt is only recognised inside this -Xplugin string, so a
                             module cannot simply append a compiler argument of its own. -->
                        <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepExcludedPaths:.*/src/test/.* -XepOpt:NullAway:OnlyNullMarked=true ${nullaway.extraOpts}</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>

        <!--
            Publishes to Sonatype Central: the same treatment for a snapshot as for a release.

            jtenman-starter is written for somebody else's class path, and until this existed nothing put
            it anywhere that somebody else's build could reach - the workflow ran "verify", so the artifact
            lived only in the ~/.m2 of whoever built it. A consumer's CI resolves from central-snapshots
            and got a 404, which reads like a broken dependency in the consumer rather than a missing step
            here.

            Every other fuinorg repository inherits this from org.fuin:pom. This one has
            spring-boot-starter-parent instead and therefore repeats it - the same plugins, the same
            versions and the same 'central-sonatype' server id, so that a release needs no second
            mechanism and no decision at the time it is made.
        -->
        <profile>

            <id>central-sonatype-release</id>

            <build>

                <plugins>

                    <!-- The passphrase reaches gpg as a system property; it arrives from the workflow's
                         environment through settings.xml. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>properties-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>set-system-properties</goal>
                                </goals>
                                <configuration>
                                    <properties>
                                        <property>
                                            <name>gpg.passphrase</name>
                                            <value>${gpg.passphrase}</value>
                                        </property>
                                    </properties>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central requires signatures for a release and not for a snapshot. Signing both
                         anyway is what makes the two paths identical, which is the point. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Sources and javadoc are attached here rather than on every build: Central needs
                        them for a release, and nineteen javadoc runs are not worth paying for on the path
                        a developer uses.

                        Both are tied to the same switch as the publish itself, because a module nobody
                        publishes needs neither - and running them anyway is not merely wasteful: javadoc
                        fails outright on jtenman-query-server, where jakarta.servlet arrives twice, once
                        on its own and once inside tomcat-embed-core. That is a real split package, but it
                        is a property of an application module that no one consumes as a library.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <skipSource>${jtenman.publishing.skip}</skipSource>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <skip>${jtenman.publishing.skip}</skip>
                            <!-- Keep the real checks - broken references, bad HTML, syntax - but do not
                                 fail a publish over a missing comment on a boilerplate member. -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central-sonatype</publishingServerId>
                            <skipPublishing>${jtenman.publishing.skip}</skipPublishing>
                        </configuration>
                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

</project>
