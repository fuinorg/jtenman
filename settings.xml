<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Nothing runs Sonar yet; this is here so that the day something does, it works.
         "sonar:sonar" is a plugin prefix, and a prefix only resolves against the configured plugin
         groups. The scanner's group is not one of Maven's defaults, and the build passes
         "-s settings.xml", so the runner's own settings are not consulted either - without this entry
         the build fails with the fairly unhelpful "No plugin found for prefix 'sonar'". -->
    <!-- Credentials for publishing, taken from the workflow's environment. The id is the one the
         'central-sonatype-release' profile names as its publishingServerId, and it is spelled the same in
         every fuinorg repository. -->
    <servers>

        <server>
            <id>central-sonatype</id>
            <username>${env.OSS_SONATYPE_USERNAME}</username>
            <password>${env.OSS_SONATYPE_TOKEN}</password>
        </server>

    </servers>

    <pluginGroups>
        <pluginGroup>org.sonarsource.scanner.maven</pluginGroup>
    </pluginGroups>

    <profiles>

        <!-- Only the passphrase: the key itself is imported into the runner's keyring by the workflow step
             before the build, the same way it is done in every other fuinorg repository. -->
        <profile>

            <id>central-sonatype-release</id>

            <properties>
                <gpg.passphrase>${env.OSS_SONATYPE_GPG_PASSPHRASE}</gpg.passphrase>
            </properties>

        </profile>

        <profile>

            <id>standard</id>

            <repositories>

                <repository>
                    <id>central.sonatype.snapshots</id>
                    <name>Central Sonatype Snapshot Repository</name>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <updatePolicy>always</updatePolicy>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>

            </repositories>

            <pluginRepositories>

                <pluginRepository>
                    <id>central.sonatype.snapshots</id>
                    <name>Central Sonatype Snapshot Repository</name>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <updatePolicy>always</updatePolicy>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>

            </pluginRepositories>

        </profile>

    </profiles>

    <activeProfiles>
        <activeProfile>standard</activeProfile>
    </activeProfiles>

</settings>
