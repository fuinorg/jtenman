<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin</groupId>
        <artifactId>jtenman</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jtenman-e2e-test</artifactId>

    <name>jtenman-e2e-test</name>
    <description>End-to-end test of an administered application against a running jtenman - test sources
        only, never published</description>

    <!--
        The only module that has both sides on its class path at once: jtenman itself and the starter an
        administered application adds. Nothing else may, and that is why the test lives here rather than
        in either of them - in "combined" the consumer's auto-configuration would apply to jtenman, and
        in "starter" jtenman's internals would have to become test dependencies of the one module kept
        deliberately lean.
    -->

    <dependencies>

        <!-- The deployable under test, as it is actually built. -->
        <dependency>
            <groupId>org.fuin</groupId>
            <artifactId>jtenman-combined</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The consumer side, as an administered application adds it. -->
        <dependency>
            <groupId>org.fuin</groupId>
            <artifactId>jtenman-starter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Optional in the starter, so it has to be asked for here - the service account needs it. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The replica is refreshed on its own thread, so every assertion about it is eventual. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-test-helper</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <!-- Test sources only - there is nothing to publish. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
